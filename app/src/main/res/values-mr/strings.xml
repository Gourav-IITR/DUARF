    <!-- Onboarding -->
    <string name="onboarding_title_1">DUARF स्कॅम डिटेक्टर</string>
    <string name="onboarding_desc_1">व्हॉट्सअ‍ॅप आणि एसएमएस सूचना तपासतो. तुमचा इनबॉक्स कधीही वाचत नाही. DUARF तुम्हाला फसवणूक, बनावट लिंक्स आणि धोकादायक एपीके फाइल्सपासून फोनवरच सुरक्षित ठेवतो.</string>

    <string name="onboarding_title_2">१००% खाजगी — इंटरनेटची कोणतीही परवानगी नाही</string>
    <string name="onboarding_desc_2">DUARF कडे इंटरनेट किंवा एसएमएस इनबॉक्स वाचण्याची परवानगी नाही. तुमचे संदेश फोनबाहेर कधीही जात नाहीत.</string>

    <string name="onboarding_title_3">सूचना प्रवेश (Notification Access)</string>
    <string name="onboarding_desc_3">व्हॉट्सअ‍ॅप आणि एसएमएस संदेश येताच त्वरित तपासण्यासाठी DUARF ला नोटिफिकेशन अ‍ॅक्सेस आवश्यक आहे. इनबॉक्स कधीही वाचला जात नाही.</string>
    <string name="btn_grant_notification_access">सूचना प्रवेश द्या</string>
    <string name="access_granted">परवानगी मिळाली</string>

    <string name="onboarding_title_4">सूचना अलर्ट</string>
    <string name="onboarding_desc_4">धोकादायक संदेश आढळल्यास अलर्ट दाखवण्यासाठी सूचना सुरू करा.</string>
    <string name="btn_grant_post_notifications">सूचना सक्षम करा</string>

    <string name="onboarding_title_5">बॅटरी ऑप्टिमायझेशन</string>
    <string name="onboarding_desc_5">काही उपकरणांवर (Xiaomi, Samsung, Oppo), DUARF बॅटरी वापर Unrestricted वर सेट करा जेणेकरून संरक्षण थांबणार नाही.</string>
    <string name="btn_battery_settings">बॅटरी सेटिंग्ज उघडा</string>

