    <!-- Reasons strings (§11) -->
    <string name="reason_l01_title">धोकादायक किंवा अनपेक्षित APK फाईल</string>
    <string name="reason_l01_detail">संदेशामध्ये अ‍ँड्रॉइड अ‍ॅप पॅकेज (.apk) जोडलेले आहे. कोणतीही अधिकृत संस्था व्हॉट्सअ‍ॅपवर अ‍ॅप्स पाठवत नाही.</string>
    <string name="reason_l02_title">ब्रँड आणि वेबसाइट विसंगती</string>
    <string name="reason_l02_detail">संदेशामध्ये ज्ञात ब्रँडचा उल्लेख आहे परंतु लिंक असत्यापित डोमेनची आहे.</string>
    <string name="reason_l03_title">बनावट किंवा फसव्या स्वरूपाचे डोमेन</string>
    <string name="reason_l03_detail">डोमेन अधिकृत संस्थेसारखे दिसते पण ते फसवणूक करणारे आहे.</string>
    <string name="reason_l04_title">संख्यात्मक आयपी पत्ता लिंक</string>
    <string name="reason_l04_detail">लिंक डोमेन नावाऐवजी थेट आयपी पत्ता वापरते.</string>
    <string name="reason_l05_title">संक्षिप्त केलेली वेब लिंक</string>
    <string name="reason_l05_detail">लिंक शॉर्टनर वापरून मूळ गंतव्य लपवते.</string>
    <string name="reason_l06_title">धोकादायक डोमेन एक्स्टेंशन</string>
    <string name="reason_l06_detail">वेबसाइट अशा डोमेन एक्स्टेंशनचा वापर करते जी सहसा फसवणुकीशी जोडलेली असते.</string>
    <string name="reason_l07_title">लिंकमध्ये दिशाभूल करणारी अक्षरे</string>
    <string name="reason_l07_detail">खऱ्या वेबसाइटसारखे भासवण्यासाठी लिंकमध्ये परदेशी किंवा बनावट अक्षरे वापरली आहेत.</string>
    <string name="reason_l08_title">लपवलेला वेब पत्ता</string>
    <string name="reason_l08_detail">सुरक्षा फिल्टर टाळण्यासाठी लिंक जाणीवपूर्वक विकृत केली आहे.</string>
    <string name="reason_l09_title">अनधिकृत सरकारी दावा</string>
    <string name="reason_l09_detail">सरकारी किंवा पोलीस असल्याचा दावा केला आहे, परंतु अधिकृत .gov.in किंवा .nic.in पत्ता नाही.</string>
    <string name="reason_l10_title">दिशाभूल करणारे लिंक गंतव्य</string>
    <string name="reason_l10_detail">वापरकर्त्याची दिशाभूल करण्यासाठी लिंकमध्ये युजर-इन्फो युक्ती वापरली आहे.</string>
    <string name="reason_l11_title">माहिती असलेली फसवणूक वेबसाइट</string>
    <string name="reason_l11_detail">वेबसाइट सत्यापित फसव्या पत्त्यांच्या ब्लॉकलिस्टवर आहे.</string>
    <string name="reason_l12_title">इतर चॅटवर जाण्याची विनंती</string>
    <string name="reason_l12_detail">प्रेषक तुम्हाला वेगळ्या प्लॅटफॉर्मवर किंवा चॅटवर नेऊ इच्छितो.</string>

    <string name="reason_a01_title">ओटीपी, पिन किंवा पासवर्ड मागितला</string>
    <string name="reason_a01_detail">गोपनीय प्रमाणीकरण कोड मागितले आहेत. बँक किंवा अधिकृत संस्था कधीही तुमचा ओटीपी मागत नाहीत.</string>
    <string name="reason_a02_title">अ‍ॅप इन्स्टॉल करण्याची सूचना</string>
    <string name="reason_a02_detail">अनोळखी अ‍ॅप किंवा रिमोट कंट्रोल टूल डाउनलोड करण्यास सांगितले आहे.</string>
    <string name="reason_a03_title">पैसे किंवा आगाऊ शुल्क मागितले</string>
    <string name="reason_a03_detail">आगाऊ शुल्क, दंड, नोंदणी शुल्क किंवा फाईल चार्ज मागितला आहे.</string>
    <string name="reason_a04_title">पैसे मिळवण्यासाठी यूपीआय पिनचा सापळा</string>
    <string name="reason_a04_detail">पैसे मिळवण्यासाठी यूपीआय पिन किंवा क्यूआर स्कॅन करण्याचा दावा केला आहे. पिन टाकल्याने नेहमी पैसे जातात, कधीही मिळत नाहीत!</string>
    <string name="reason_a05_title">आधार, पॅन किंवा कार्ड तपशील मागितले</string>
    <string name="reason_a05_detail">वैयक्तिक किंवा बँकिंग माहिती मागितली आहे.</string>
    <string name="reason_a06_title">गोपनीयता किंवा व्हिडिओ कॉलची मागणी</string>
    <string name="reason_a06_detail">कुटुंबाला किंवा पोलिसांना न सांगण्याची सक्ती केली जात आहे किंवा सतत कॉलवर राहण्यास भाग पाडले जात आहे.</string>
    <string name="reason_a07_title">खाते पडताळणीसाठी लिंकवर क्लिक करा</string>
    <string name="reason_a07_detail">सेवा सुरू ठेवण्यासाठी असत्यापित लिंकवर क्लिक करण्याचे निर्देश दिले आहेत.</string>
    <string name="reason_a08_title">टेलिग्रामवर जाण्याची विनंती</string>
    <string name="reason_a08_detail">व्हॉट्सअ‍ॅपवरून टेलिग्रामवर जाण्यास सांगितले आहे.</string>
    <string name="reason_a09_title">नवीन नंबरवरून पैशांची मागणी</string>
    <string name="reason_a09_detail">ओळखीची व्यक्ती असल्याचा दावा करून नवीन नंबरवरून तातडीने पैसे मागितले आहेत.</string>

    <string name="reason_p01_title">तातडीची किंवा कृत्रिम मुदत</string>
    <string name="reason_p01_detail">विचार न करता घाईघाईने निर्णय घेण्यासाठी काही तासांची मुदत दिली आहे.</string>
    <string name="reason_p02_title">खाते किंवा सिम ब्लॉक करण्याची धमकी</string>
    <string name="reason_p02_detail">तुमचे बँक खाते, केवायसी किंवा सिम ब्लॉक होईल अशी धमकी दिली आहे.</string>
    <string name="reason_p03_title">अटक किंवा कायदेशीर कारवाईची धमकी</string>
    <string name="reason_p03_detail">अटक वॉरंट, पोलीस एफआयआर किंवा डिजिटल अटकाची भीती दाखवली आहे.</string>
    <string name="reason_p04_title">वीज पुरवठा खंडित करण्याची धमकी</string>
    <string name="reason_p04_detail">आज रात्रीच वीज पुरवठा खंडित केला जाईल अशी धमकी दिली आहे.</string>
    <string name="reason_p05_title">लॉटरी किंवा बक्षीसाचे आमिष</string>
    <string name="reason_p05_detail">भाग न घेतलेल्या लॉटरी किंवा लकी ड्रॉमध्ये मोठी रक्कम जिंकल्याचे आमिष दाखवले आहे.</string>
    <string name="reason_p06_title">घरबसल्या कामाचे आमिष</string>
    <string name="reason_p06_detail">व्हिडिओ लाईक किंवा सोप्या कामांसाठी अवास्तव दैनिक कमाईचे खोटे आश्वासन दिले आहे.</string>
    <string name="reason_p07_title">उच्च किंवा हमी परतावा</string>
    <string name="reason_p07_detail">पैसे दुप्पट करणे किंवा शेअर बाजारात हमी नफ्याचे खोटे आश्वासन दिले आहे.</string>
    <string name="reason_p08_title">कागदपत्रांशिवाय झटपट कर्ज</string>
    <string name="reason_p08_detail">फसव्या झटपट कर्ज मंजुरीची जाहिरात केली आहे.</string>
    <string name="reason_p09_title">कॅशबॅक किंवा परताव्याचे आमिष</string>
    <string name="reason_p09_detail">शिल्लक रिवॉर्ड किंवा कॅशबॅक उपलब्ध असल्याचा दावा केला आहे.</string>
    <string name="reason_p10_title">संस्थेचे सोंग घेणे</string>
    <string name="reason_p10_detail">वैयक्तिक मोबाईल नंबरवरून बँक किंवा सरकारी संस्थेचे प्रतिनिधी असल्याचा दावा केला आहे.</string>
    <string name="reason_p11_title">बनावट पार्सल डिलिव्हरी समस्या</string>
    <string name="reason_p11_detail">पत्ता अपूर्ण असल्यामुळे पार्सल अडकल्याचा दावा केला आहे.</string>
    <string name="reason_p12_title">बनावट ट्रॅफिक चलान सूचना</string>
    <string name="reason_p12_detail">वाहनाच्या चलानसाठी त्वरित पैसे भरण्याचा आग्रह केला आहे.</string>
    <string name="reason_p13_title">लग्नाचे आमंत्रण आमिष</string>
    <string name="reason_p13_detail">निमंत्रण पत्रिकेच्या नावाखाली धोकादायक फाईल पाठवली आहे.</string>
    <string name="reason_p14_title">सामान्य जन-अभिवादन</string>
    <string name="reason_p14_detail">मोठ्या प्रमाणावर फसवणूक करणाऱ्या मोहिमांमध्ये वापरले जाणारे सामान्य अभिवादन वापरले आहे.</string>
    <string name="reason_t01_title">लपवलेला किंवा हाताळलेला मजकूर</string>
    <string name="reason_t01_detail">डिटेक्शन टाळण्यासाठी अदृश्य किंवा संशयास्पद अक्षरे वापरली आहेत.</string>
    <string name="reason_s01_title">अनोळखी नंबरवरून पाठवलेला संदेश</string>
    <string name="reason_s01_detail">तुमच्या संपर्कांमध्ये नसलेल्या नंबरवरून पाठवला आहे.</string>
    <string name="reason_s02_title">परदेशी कंट्री कोडवरून पाठवलेला संदेश</string>
    <string name="reason_s02_detail">भारताबाहेरील आंतरराष्ट्रीय नंबरवरून पाठवला आहे.</string>
    <string name="reason_s03_title">या प्रेषकाकडून आलेला पहिलाच संदेश</string>
    <string name="reason_s03_detail">तुम्हाला या नंबरवरून यापूर्वी कधीही संदेश आलेला नाही.</string>
    <string name="reason_s04_title">वैयक्तिक नंबरवरून संस्थेचा दावा</string>
    <string name="reason_s04_detail">अधिकृत संस्था नोंदणीकृत हेडरवरून संदेश पाठवतात, वैयक्तिक १०-अंकी मोबाईल नंबरवरून नाही.</string>
    <string name="reason_s05_title">हेडर ब्रँड विसंगती किंवा जाहिरात संदेशात मागणी</string>
    <string name="reason_s05_detail">हेडर ब्रँड आणि संदेशातील दावा जुळत नाही किंवा जाहिरात एसएमएसमध्ये संवेदनशील माहिती मागितली आहे.</string>
    <string name="reason_model_title">संशयास्पद स्कॅम पॅटर्न</string>
    <string name="reason_model_detail">मजकुराची एकूण रचना ज्ञात फसवणूक मोहिमांशी जुळते.</string>

